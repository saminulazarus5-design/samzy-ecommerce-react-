{
  "name": "samzy-ecommerce",
  "version": "1.0.0",
  "description": "Samzy Communications — full-stack e-commerce website with SQLite database, admin dashboard and Paystack payments.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n api,web -c blue,green \"node --watch server.js\" \"npm --prefix client run dev\"",
    "seed": "node server/seed.js",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build"
  },
  "keywords": [
    "ecommerce",
    "express",
    "sqlite",
    "paystack"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
